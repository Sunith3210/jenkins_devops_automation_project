pipeline {
    agent any

    stages {

        stage('Show Parameters') {
            steps {
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Node: ${params.NODE}"
                echo "App Name: ${params.ENV_APPNAME}"
                echo "Version: ${params.ENV_VERSION}"
                echo "Replicas: ${params.ENV_REPLICAS}"
                echo "Log Level: ${params.ENV_LOGLEVEL}"
                echo "Node Name: ${params.NODE_NAME}"
                echo "Node Type: ${params.NODE_TYPE}"
                echo "Region: ${params.NODE_REGION}"
                echo "Availability Zone: ${params.NODE_AZ}"
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                script {

                    /*
                     * ONE FIXED FEATURE BRANCH
                     */
                    env.FEATURE_BRANCH = "feature/config-update"

                    sh '''
                        git fetch origin main

                        git checkout main
                        git reset --hard origin/main

                        git fetch origin feature/config-update || true

                        if git ls-remote --exit-code --heads origin feature/config-update > /dev/null 2>&1
                        then
                            echo "Feature branch already exists."

                            git checkout -B feature/config-update origin/main
                        else
                            echo "Feature branch does not exist. Creating it..."

                            git checkout -b feature/config-update
                        fi

                        echo "Current branch:"
                        git branch --show-current
                    '''

                    echo "Feature Branch: ${env.FEATURE_BRANCH}"
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                script {

                    def envFile = "environment/${params.ENVIRONMENT}.json"
                    def nodeFile = "node/${params.NODE}.json"

                    sh """
                        sed -i -E 's/^  "environment": "[^"]*",/  "environment": "${params.ENVIRONMENT}",/' ${envFile}
                        sed -i -E 's/^  "appName": "[^"]*",/  "appName": "${params.ENV_APPNAME}",/' ${envFile}
                        sed -i -E 's/^  "version": "[^"]*",/  "version": "${params.ENV_VERSION}",/' ${envFile}
                        sed -i -E 's/^  "replicas": [0-9]+,/  "replicas": ${params.ENV_REPLICAS},/' ${envFile}
                        sed -i -E 's/^  "logLevel": "[^"]*",/  "logLevel": "${params.ENV_LOGLEVEL}",/' ${envFile}

                        sed -i -E 's/^  "environment": "[^"]*",/  "environment": "${params.NODE}",/' ${nodeFile}
                        sed -i -E 's/^  "nodeName": "[^"]*",/  "nodeName": "${params.NODE_NAME}",/' ${nodeFile}
                        sed -i -E 's/^  "nodeType": "[^"]*",/  "nodeType": "${params.NODE_TYPE}",/' ${nodeFile}
                        sed -i -E 's/^  "region": "[^"]*",/  "region": "${params.NODE_REGION}",/' ${nodeFile}
                        sed -i -E 's/^  "availabilityZone": "[^"]*",/  "availabilityZone": "${params.NODE_AZ}",/' ${nodeFile}
                    """
                }
            }
        }

        stage('Show Changes') {
            steps {
                sh """
                    echo "===== ENVIRONMENT FILE ====="
                    cat environment/${params.ENVIRONMENT}.json

                    echo "===== NODE FILE ====="
                    cat node/${params.NODE}.json

                    echo "===== GIT DIFF ====="
                    git diff
                """
            }
        }

        stage('Commit Changes') {
            steps {
                script {

                    sh '''
                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add environment/*.json
                        git add node/*.json
                    '''

                    def changes = sh(
                        script: 'git diff --cached --quiet',
                        returnStatus: true
                    )

                    if (changes == 0) {

                        echo "No changes detected."
                        currentBuild.result = 'SUCCESS'

                    } else {

                        sh """
                            git commit -m "Automated configuration update - ${params.ENVIRONMENT} - ${params.NODE}"
                        """
                    }
                }
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {

                    sh '''
                        git push \
                        https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/chvkarthik-87/jenkins-config-automation.git \
                        feature/config-update \
                        --force
                    '''
                }
            }
        }

        stage('Create or Get Pull Request') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        /*
                         * First check whether a PR already exists
                         * for feature/config-update.
                         */

                        sh '''
                            curl -sS \
                              -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                              -H "Accept: application/vnd.github+json" \
                              -H "X-GitHub-Api-Version: 2022-11-28" \
                              "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls?state=open&head=chvkarthik-87:feature/config-update&base=main" \
                              > existing-pr.json
                        '''

                        def existingPrNumber = sh(
                            script: '''
                                grep -o '"number"[[:space:]]*:[[:space:]]*[0-9]*' existing-pr.json |
                                head -1 |
                                grep -o '[0-9]*$' || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (existingPrNumber) {

                            echo "======================================"
                            echo "EXISTING PULL REQUEST FOUND"
                            echo "PR NUMBER: ${existingPrNumber}"
                            echo "======================================"

                            env.PR_NUMBER = existingPrNumber

                        } else {

                            echo "No open PR found."
                            echo "Creating new Pull Request..."

                            sh '''
                                cat > pr.json <<EOF
{
  "title": "Automated Configuration Update",
  "head": "feature/config-update",
  "base": "main",
  "body": "This Pull Request was automatically created by Jenkins."
}
EOF
                            '''

                            sh '''
                                curl -sS -X POST \
                                  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls \
                                  --data-binary @pr.json \
                                  > pr-response.json
                            '''

                            echo "===== GITHUB PR RESPONSE ====="

                            sh 'cat pr-response.json'

                            def newPrNumber = sh(
                                script: '''
                                    grep -o '"number"[[:space:]]*:[[:space:]]*[0-9]*' pr-response.json |
                                    head -1 |
                                    grep -o '[0-9]*$'
                                ''',
                                returnStdout: true
                            ).trim()

                            if (!newPrNumber) {

                                sh 'cat pr-response.json'

                                error("Pull Request creation failed.")
                            }

                            env.PR_NUMBER = newPrNumber

                            echo "======================================"
                            echo "NEW PULL REQUEST CREATED"
                            echo "PR NUMBER: ${env.PR_NUMBER}"
                            echo "======================================"
                        }
                    }
                }
            }
        }

        stage('Check Pull Request') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        def mergeableState = ""

                        for (int i = 1; i <= 6; i++) {

                            echo "Checking Pull Request..."
                            echo "Attempt ${i}/6"

                            sh '''
                                curl -sS \
                                  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls/${PR_NUMBER}" \
                                  > pr-status.json
                            '''

                            def prState = sh(
                                script: '''
                                    grep -o '"state"[[:space:]]*:[[:space:]]*"[^"]*"' pr-status.json |
                                    head -1 |
                                    sed 's/.*"state"[[:space:]]*:[[:space:]]*"//; s/".*//'
                                ''',
                                returnStdout: true
                            ).trim()

                            mergeableState = sh(
                                script: '''
                                    grep -o '"mergeable_state"[[:space:]]*:[[:space:]]*"[^"]*"' pr-status.json |
                                    head -1 |
                                    sed 's/.*"mergeable_state"[[:space:]]*:[[:space:]]*"//; s/".*//'
                                ''',
                                returnStdout: true
                            ).trim()

                            echo "PR State: ${prState}"
                            echo "Mergeable State: ${mergeableState}"

                            if (prState != "open") {
                                error("Pull Request is not open.")
                            }

                            if (mergeableState == "dirty") {
                                error("Pull Request has merge conflicts.")
                            }

                            if (mergeableState == "blocked") {
                                error("Pull Request is blocked.")
                            }

                            if (mergeableState != "unknown" &&
                                mergeableState != "") {
                                break
                            }

                            echo "GitHub is still calculating mergeability..."

                            sleep time: 5, unit: 'SECONDS'
                        }

                        if (mergeableState == "unknown" ||
                            mergeableState == "") {

                            error("GitHub could not determine mergeability.")
                        }

                        echo "Pull Request is ready for merge."
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        echo "Merging Pull Request #${PR_NUMBER} automatically..."

                        sh '''
                            curl -sS -X PUT \
                              -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                              -H "Accept: application/vnd.github+json" \
                              -H "X-GitHub-Api-Version: 2022-11-28" \
                              "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls/${PR_NUMBER}/merge" \
                              -d '{"merge_method":"merge"}' \
                              > merge-response.json
                        '''

                        echo "===== GITHUB MERGE RESPONSE ====="

                        sh 'cat merge-response.json'

                        def merged = sh(
                            script: '''
                                grep -o '"merged"[[:space:]]*:[[:space:]]*[a-z]*' merge-response.json |
                                head -1 |
                                sed 's/.*:[[:space:]]*//'
                            ''',
                            returnStdout: true
                        ).trim()

                        if (merged == "true") {

                            echo "======================================"
                            echo "PR MERGED SUCCESSFULLY"
                            echo "PR NUMBER: ${PR_NUMBER}"
                            echo "MAIN BRANCH UPDATED"
                            echo "======================================"

                        } else {

                            echo "===== MERGE FAILED ====="

                            sh 'cat merge-response.json'

                            error("Automatic Pull Request merge failed.")
                        }
                    }
                }
            }
        }

        stage('Verify Main Branch') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        def envFile =
                            "environment/${params.ENVIRONMENT}.json"

                        sh """
                            curl -sS \
                              -H "Authorization: Bearer \$GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              -H "X-GitHub-Api-Version: 2022-11-28" \
                              "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/contents/${envFile}?ref=main" \
                              > main-verification.json
                        """

                        echo "===== MAIN BRANCH VERIFICATION ====="

                        sh 'cat main-verification.json'

                        echo "======================================"
                        echo "MAIN BRANCH UPDATE VERIFIED"
                        echo "======================================"
                    }
                }
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "AUTOMATION SUCCESSFUL"
            echo "======================================"
            echo "1. Parameters received"
            echo "2. Single feature branch used"
            echo "3. JSON files updated"
            echo "4. Changes committed"
            echo "5. Feature branch pushed"
            echo "6. Pull Request created/found"
            echo "7. Pull Request merged automatically"
            echo "8. Main branch updated"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "CONFIGURATION AUTOMATION FAILED"
            echo "======================================"
        }
    }
}
