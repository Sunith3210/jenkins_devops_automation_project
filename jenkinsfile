
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'UPDATE_TARGET',
            choices: ['ENVIRONMENT', 'NODE'],
            description: 'Choose which configuration to update'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Environment JSON to update'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Node JSON to update'
        )

        string(
            name: 'ENV_APPNAME',
            defaultValue: 'myapp',
            description: 'Application name'
        )

        string(
            name: 'ENV_VERSION',
            defaultValue: '2.0.0',
            description: 'Application version'
        )

        string(
            name: 'ENV_REPLICAS',
            defaultValue: '1',
            description: 'Positive replica count'
        )

        choice(
            name: 'ENV_LOGLEVEL',
            choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'],
            description: 'Application log level'
        )

        string(
            name: 'NODE_NAME',
            defaultValue: 'node-01',
            description: 'Node name'
        )

        choice(
            name: 'NODE_TYPE',
            choices: ['worker', 'control-plane'],
            description: 'Node type'
        )

        string(
            name: 'NODE_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'NODE_AZ',
            defaultValue: 'us-east-1a',
            description: 'Availability zone'
        )

        booleanParam(
            name: 'PUBLISH_CHANGES',
            defaultValue: true,
            description: 'Push feature branch, create/reuse PR, and merge into main after checks pass'
        )
    }

    environment {
        GITHUB_OWNER = 'Sunith3210'
        GITHUB_REPO = 'jenkins_devops_automation_project'
        FEATURE_BRANCH = 'feature/config-update'
        NEXUS_URL = 'http://100.54.232.46:8081/repository/jenkins-config-artifacts'
        SONAR_PROJECT_KEY = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout main') {
            steps {
                deleteDir()
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/Sunith3210/jenkins_devops_automation_project.git'
            }
        }

        stage('Validate parameters') {
            steps {
                script {
                    if (!(params.UPDATE_TARGET in ['ENVIRONMENT', 'NODE'])) {
                        error('Choose ENVIRONMENT or NODE.')
                    }

                    if (!(params.ENV_REPLICAS ==~ /^[1-9][0-9]*$/)) {
                        error('Replicas must be a positive integer.')
                    }

                    if (!(params.ENV_APPNAME ==~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/)) {
                        error('Invalid application name.')
                    }

                    if (!(params.ENV_VERSION ==~ /^[A-Za-z0-9][A-Za-z0-9._+-]*$/)) {
                        error('Invalid version.')
                    }

                    if (!(params.NODE_NAME ==~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/)) {
                        error('Invalid node name.')
                    }

                    if (!(params.NODE_REGION ==~ /^[A-Za-z0-9-]+$/) ||
                        !(params.NODE_AZ ==~ /^[A-Za-z0-9-]+$/)) {
                        error('Invalid node region or availability zone.')
                    }

                    env.TARGET_FILE = params.UPDATE_TARGET == 'ENVIRONMENT'
                        ? "environment/${params.ENVIRONMENT}.json"
                        : "node/${params.NODE}.json"
                }

                sh '''
                    set -eu
                    test -f "$TARGET_FILE"
                    python3 -m json.tool "$TARGET_FILE" >/dev/null
                    echo "Selected target: $UPDATE_TARGET"
                    echo "Selected file: $TARGET_FILE"
                '''
            }
        }

        stage('Prepare fixed feature branch') {
            steps {
                sh '''
                    set -eu

                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git fetch origin main
                    git checkout -B main origin/main

                    if git ls-remote --exit-code --heads origin "$FEATURE_BRANCH" >/dev/null 2>&1; then
                        git fetch origin "$FEATURE_BRANCH"
                        git checkout -B "$FEATURE_BRANCH" "origin/$FEATURE_BRANCH"

                        # Bring the latest main changes into the feature branch.
                        git merge origin/main
                    else
                        git checkout -b "$FEATURE_BRANCH"
                    fi

                    echo "Using branch: $FEATURE_BRANCH"
                '''
            }
        }

        stage('Update selected JSON') {
            steps {
                withEnv([
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${params.ENV_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_REGION=${params.NODE_REGION}",
                    "CONFIG_AZ=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 <<'PY'
import json
import os

target = os.environ["TARGET_FILE"]

with open(target, encoding="utf-8") as f:
    data = json.load(f)

if os.environ["UPDATE_TARGET"] == "ENVIRONMENT":
    data["environment"] = os.environ["ENVIRONMENT"]
    data["appName"] = os.environ["APP_NAME"]
    data["version"] = os.environ["APP_VERSION"]
    data["replicas"] = int(os.environ["APP_REPLICAS"])
    data["logLevel"] = os.environ["APP_LOGLEVEL"]
else:
    data["environment"] = os.environ["NODE"]
    data["nodeName"] = os.environ["CONFIG_NODE_NAME"]
    data["nodeType"] = os.environ["CONFIG_NODE_TYPE"]
    data["region"] = os.environ["CONFIG_REGION"]
    data["availabilityZone"] = os.environ["CONFIG_AZ"]

with open(target, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\\n")

with open(target, encoding="utf-8") as f:
    json.load(f)

print("Updated and validated:", target)
PY

                        git diff -- "$TARGET_FILE"
                    '''
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar_scanner'

                    withSonarQubeEnv('devops_project') {
                        sh """
                            set -eu
                            '${scannerHome}/bin/sonar-scanner' \
                              -Dsonar.projectKey='${SONAR_PROJECT_KEY}' \
                              -Dsonar.projectName='${SONAR_PROJECT_KEY}' \
                              -Dsonar.sources=environment,node \
                              -Dsonar.scm.provider=git
                        """
                    }
                }
            }
        }

        stage('Wait for SonarQube quality gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package selected configuration') {
            steps {
                sh '''
                    set -eu
                    mkdir -p dist

                    FILE="dist/config-${UPDATE_TARGET}-${BUILD_NUMBER}.tar.gz"

                    tar -czf "$FILE" "$TARGET_FILE"
                    tar -tzf "$FILE"

                    echo "Created artifact: $FILE"
                '''
            }
        }

        stage('Upload artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-upload-creds',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        FILE="dist/config-${UPDATE_TARGET}-${BUILD_NUMBER}.tar.gz"
                        URL="${NEXUS_URL}/${UPDATE_TARGET}/${BUILD_NUMBER}/$(basename "$FILE")"

                        CODE=$(curl -sS -o /dev/null -w "%{http_code}" \
                            -u "$NEXUS_USER:$NEXUS_PASS" \
                            -T "$FILE" "$URL")

                        echo "Nexus upload HTTP status: $CODE"

                        case "$CODE" in
                            200|201|204) ;;
                            *) echo "Nexus upload failed"; exit 1 ;;
                        esac

                        CODE=$(curl -sS -o /dev/null -w "%{http_code}" \
                            -u "$NEXUS_USER:$NEXUS_PASS" "$URL")

                        echo "Nexus read-back HTTP status: $CODE"
                        test "$CODE" = "200"
                    '''
                }

                archiveArtifacts artifacts: 'dist/*.tar.gz', fingerprint: true
            }
        }

        stage('Prepare Git change') {
            steps {
                sh '''
                    set -eu

                    git add -- "$TARGET_FILE"

                    if ! git diff --cached --quiet; then
                        git commit -m "Update ${UPDATE_TARGET} configuration (build ${BUILD_NUMBER})"
                    else
                        echo "No new configuration changes to commit."
                    fi
                '''
            }
        }

        stage('Publish branch, create/reuse PR, and merge') {
            when {
                expression { params.PUBLISH_CHANGES }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        AUTH=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            push origin "HEAD:refs/heads/$FEATURE_BRANCH"

                        git fetch origin main

                        # If the branch has no file changes compared with main,
                        # there is nothing to merge.
                        if git diff --quiet origin/main HEAD; then
                            echo "No file differences from main. Nothing to merge."
                            exit 0
                        fi

                        PR_QUERY_URL="https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/pulls?state=open&head=${GITHUB_OWNER}:${FEATURE_BRANCH}&base=main"

                        CODE=$(curl -sS -o pulls.json -w "%{http_code}" \
                            -u "$GITHUB_USER:$GITHUB_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            "$PR_QUERY_URL")

                        if [ "$CODE" != "200" ]; then
                            echo "Could not check existing pull requests. HTTP $CODE"
                            cat pulls.json
                            exit 1
                        fi

                        PR_NUMBER=$(python3 -c '
import json
with open("pulls.json", encoding="utf-8") as f:
    pulls = json.load(f)
print(pulls[0]["number"] if pulls else "")
')

                        if [ -z "$PR_NUMBER" ]; then
                            python3 <<'PY'
import json
import os

with open("pr-request.json", "w", encoding="utf-8") as f:
    json.dump({
        "title": "Automated configuration update",
        "body": "Configuration update created by Jenkins after the SonarQube quality gate and Nexus upload succeeded.",
        "head": os.environ["FEATURE_BRANCH"],
        "base": "main"
    }, f)
PY

                            CODE=$(curl -sS -o pr-response.json -w "%{http_code}" \
                                -u "$GITHUB_USER:$GITHUB_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                -H "Content-Type: application/json" \
                                -d @pr-request.json \
                                "https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/pulls")

                            if [ "$CODE" != "201" ]; then
                                echo "PR creation failed. HTTP $CODE"
                                python3 -m json.tool pr-response.json || true
                                exit 1
                            fi

                            PR_NUMBER=$(python3 -c '
import json
with open("pr-response.json", encoding="utf-8") as f:
    print(json.load(f)["number"])
')

                            echo "Created pull request #$PR_NUMBER"
                        else
                            echo "Reusing existing pull request #$PR_NUMBER"
                        fi

                        # Merge only after all earlier pipeline stages succeeded.
                        MERGE_URL="https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge"

                        CODE=$(curl -sS -o merge-response.json -w "%{http_code}" \
                            -X PUT \
                            -u "$GITHUB_USER:$GITHUB_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            -d '{"merge_method":"squash"}' \
                            "$MERGE_URL")

                        if [ "$CODE" != "200" ]; then
                            echo "Automatic merge failed. HTTP $CODE"
                            python3 -m json.tool merge-response.json || true
                            exit 1
                        fi

                        python3 <<'PY'
import json

with open("merge-response.json", encoding="utf-8") as f:
    result = json.load(f)

if not result.get("merged", False):
    raise SystemExit("GitHub did not confirm the merge.")

print("Merge successful:", result.get("message", "Merged into main"))
PY
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded. Target: ${params.UPDATE_TARGET}"
            echo "Feature branch: feature/config-update"
            script {
                if (params.PUBLISH_CHANGES) {
                    echo "Publishing was enabled; see the console log to confirm the merge result."
                } else {
                    echo "Publishing was disabled; no push or automatic merge was attempted."
                }
            }
        }

        failure {
            echo 'Pipeline failed. Check the console output before retrying.'
        }

        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
