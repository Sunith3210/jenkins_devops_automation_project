pipeline {
    agent any

    stages {

        stage('Show Parameters') {
            steps {
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Node: ${params.NODE}"
                echo "App Name: ${params.ENV_APPNAME}"
                echo "Version: ${params.ENV_VERSION}"
                echo "Replicas: ${params.ENV_REPLICAS}"
                echo "Log Level: ${params.ENV_LOGLEVEL}"
                echo "Node Name: ${params.NODE_NAME}"
                echo "Node Type: ${params.NODE_TYPE}"
                echo "Region: ${params.NODE_REGION}"
                echo "Availability Zone: ${params.NODE_AZ}"
            }
        }

        stage('Create Feature Branch') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${params.ENVIRONMENT}-${params.NODE}-${env.BUILD_NUMBER}"

                    sh """
                        git checkout -b ${FEATURE_BRANCH}
                    """

                    echo "Feature Branch: ${FEATURE_BRANCH}"
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                script {

                    def envFile = "environment/${params.ENVIRONMENT}.json"
                    def nodeFile = "node/${params.NODE}.json"

                    sh """
                        sed -i -E 's/^  "environment": "[^"]*",/  "environment": "${params.ENVIRONMENT}",/' ${envFile}
                        sed -i -E 's/^  "appName": "[^"]*",/  "appName": "${params.ENV_APPNAME}",/' ${envFile}
                        sed -i -E 's/^  "version": "[^"]*",/  "version": "${params.ENV_VERSION}",/' ${envFile}
                        sed -i -E 's/^  "replicas": [0-9]+,/  "replicas": ${params.ENV_REPLICAS},/' ${envFile}
                        sed -i -E 's/^  "logLevel": "[^"]*",/  "logLevel": "${params.ENV_LOGLEVEL}",/' ${envFile}

                        sed -i -E 's/^  "environment": "[^"]*",/  "environment": "${params.NODE}",/' ${nodeFile}
                        sed -i -E 's/^  "nodeName": "[^"]*",/  "nodeName": "${params.NODE_NAME}",/' ${nodeFile}
                        sed -i -E 's/^  "nodeType": "[^"]*",/  "nodeType": "${params.NODE_TYPE}",/' ${nodeFile}
                        sed -i -E 's/^  "region": "[^"]*",/  "region": "${params.NODE_REGION}",/' ${nodeFile}
                        sed -i -E 's/^  "availabilityZone": "[^"]*",/  "availabilityZone": "${params.NODE_AZ}",/' ${nodeFile}
                    """
                }
            }
        }

        stage('Show Changes') {
            steps {
                sh """
                    echo "===== ENVIRONMENT FILE ====="
                    cat environment/${params.ENVIRONMENT}.json

                    echo "===== NODE FILE ====="
                    cat node/${params.NODE}.json

                    echo "===== GIT DIFF ====="
                    git diff
                """
            }
        }

        stage('Commit Changes') {
            steps {
                sh """
                    git config user.name "Jenkins"
                    git config user.email "jenkins@localhost"

                    git add environment/${params.ENVIRONMENT}.json
                    git add node/${params.NODE}.json

                    git commit -m "Automated config update for ${params.ENVIRONMENT} and ${params.NODE}"
                """
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {

                    sh '''
                        git push https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/chvkarthik-87/jenkins-config-automation.git ${FEATURE_BRANCH}
                    '''
                }
            }
        }

        stage('Create Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        sh '''
                            cat > pr.json <<EOF
{
  "title": "Automated config update - Build ${BUILD_NUMBER}",
  "head": "${FEATURE_BRANCH}",
  "base": "main",
  "body": "This Pull Request was automatically created by Jenkins."
}
EOF
                        '''

                        def response = sh(
                            script: '''
                                curl -sS -X POST \
                                  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls \
                                  --data-binary @pr.json
                            ''',
                            returnStdout: true
                        ).trim()

                        sh 'rm -f pr.json'

                        echo "===== GITHUB PR RESPONSE ====="
                        echo response

                        def pr =
                            new groovy.json.JsonSlurperClassic().parseText(response)

                        if (!pr.number) {
                            error("PR creation failed: ${response}")
                        }

                        env.PR_NUMBER = pr.number.toString()

                        echo "======================================"
                        echo "PR CREATED AUTOMATICALLY"
                        echo "PR Number: ${env.PR_NUMBER}"
                        echo "PR URL: ${pr.html_url}"
                        echo "======================================"
                    }
                }
            }
        }

        stage('Check Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        def prStatus = sh(
                            script: '''
                                curl -sS \
                                  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls/${PR_NUMBER}
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "===== PR STATUS ====="
                        echo prStatus

                        def prData =
                            new groovy.json.JsonSlurperClassic().parseText(prStatus)

                        echo "PR State: ${prData.state}"
                        echo "Mergeable: ${prData.mergeable}"
                        echo "Mergeable State: ${prData.mergeable_state}"

                        if (prData.state != "open") {
                            error("PR is not open.")
                        }
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        def mergeResponse = sh(
                            script: '''
                                curl -sS -X PUT \
                                  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls/${PR_NUMBER}/merge \
                                  -d '{"merge_method":"merge"}'
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "===== GITHUB MERGE RESPONSE ====="
                        echo mergeResponse

                        def result =
                            new groovy.json.JsonSlurperClassic().parseText(mergeResponse)

                        if (result.merged == true) {

                            echo "======================================"
                            echo "PR MERGED SUCCESSFULLY"
                            echo "PR NUMBER: ${PR_NUMBER}"
                            echo "MAIN BRANCH UPDATED"
                            echo "======================================"

                        } else {

                            def message =
                                result.message ?: "Unknown GitHub merge error"

                            def sha =
                                result.sha ?: "N/A"

                            def documentation =
                                result.documentation_url ?: "N/A"

                            error("""
Automatic PR merge failed.

Message: ${message}
SHA: ${sha}
Documentation: ${documentation}

PR Number: ${PR_NUMBER}
""")
                        }
                    }
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    script {

                        def mainResponse = sh(
                            script: '''
                                curl -sS \
                                  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/contents/environment/${ENVIRONMENT}.json?ref=main
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "===== MAIN BRANCH VERIFICATION ====="
                        echo mainResponse

                        echo "MAIN BRANCH UPDATE VERIFIED"
                    }
                }
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "AUTOMATION SUCCESSFUL"
            echo "======================================"
            echo "1. Parameters received"
            echo "2. Feature branch created"
            echo "3. JSON files updated"
            echo "4. Changes committed"
            echo "5. Feature branch pushed"
            echo "6. Pull Request created"
            echo "7. Pull Request merged automatically"
            echo "8. Main branch updated"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "CONFIGURATION AUTOMATION FAILED"
            echo "======================================"
        }
    }
}
